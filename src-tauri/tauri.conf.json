{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pia",
  "version": "../package.json",
  "identifier": "io.github.nam-likestocode.pia",
  "build": {
    "beforeDevCommand": "npm run build:helper && npx vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pia",
        "width": 1100,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/pia-helper"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "publisher": "NAM-likestocode",
    "shortDescription": "Pia hilft dir am Computer",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGQ0EzNzk1MzA4MkY0RjMKUldUejlJSXdsVGZLenpzS2MvZGlUVnk3SExiQ0x4UHA5Tm8vUmlpUjlFZjBvbDVxcXlIYWtqMSsK",
      "endpoints": ["https://github.com/NAM-likestocode/pia/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
