{
  "name": "pia",
  "version": "0.1.0",
  "private": true,
  "description": "Pia: a gentle, locked-down AI helper for people who are not comfortable with computers.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "build": "npm run build:helper && tauri build",
    "build:ui": "vite build",
    "build:helper": "node scripts/build-helper.mjs",
    "build:helper:windows": "node scripts/build-helper.mjs --target=windows",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "helper": "bun helper/src/main.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "docx": "^9.11.0",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "marked": "^18.1.1",
    "pdf-lib": "^1.17.1",
    "typebox": "^1.3.37"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.5",
    "bun": "^1.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "bun@1.4.3": true,
    "@google/genai": false,
    "protobufjs": false
  }
}
